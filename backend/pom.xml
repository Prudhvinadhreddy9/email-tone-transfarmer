<?xml version="1.0" encoding="UTF-8"?>
<!--
   email-tone-transformer / backend — Spring Boot 3.4.x + Spring AI 1.0.x.

   WHY these versions:
     * Boot 3.4.x is the current GA train; needs Java 17+. We use 21 for records,
       pattern matching, and virtual threads if we ever want them.
     * Spring AI 1.0.x is the GA line. Artifact NAME changed at GA from the
       legacy `spring-ai-openai-spring-boot-starter` to `spring-ai-starter-model-openai`.
       Older tutorials still show the old name; this project uses the new one.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.learning</groupId>
    <artifactId>email-tone-transformer</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>email-tone-transformer-backend</name>
    <description>AI email rewriter — learning reference for Spring AI 1.0.x.</description>

    <properties>
        <java.version>21</java.version>
        <!-- Pin Spring AI BOM. Bump in lockstep with the Boot parent version. -->
        <spring-ai.version>1.0.0</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web layer: REST controllers + JSON via Jackson. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation (jakarta @NotBlank, @Size, @Valid). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
           Spring AI OpenAI starter — auto-configures OpenAiChatModel from
           the spring.ai.openai.* properties. Provides ChatClient.builder.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
           Spring Retry — provides @Retryable used by EmailTransformService
           to re-run the LLM call when it returns malformed JSON. Needs
           @EnableRetry on a @Configuration class to take effect.
        -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aspects</artifactId>
        </dependency>

        <!-- Lombok — @Slf4j, @RequiredArgsConstructor. Records cover most data classes. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ============== TEST SCOPE ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
